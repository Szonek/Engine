<rml>
<head>
	<title>Main-UI</title>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="project_c_gameplay_ui.rcss"/>
</head>
<body>
	<div data-model="DataModel_Main_UI">	
		<div data-for="itm_go, idx : items_go">
			<div class="item_on_ground" 
				data-event-click="equip(itm_go)"
				data-style-left="items_pos_x[idx]" data-style-bottom="items_pos_y[idx]">
				<p>{{items_name[idx]}}_{{itm_go}}</p>
			</div>
		</div>
		
		<div data-for="enemy_go, idx : enemies_go">
			<div class="healthbar" data-style-left="enemies_pos_x[idx]" data-style-bottom="enemies_pos_y[idx]"></div> 
		</div>
	</div>
</body>
</rml>