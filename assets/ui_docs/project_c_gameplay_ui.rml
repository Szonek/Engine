<rml>
<head>
	<title>Hello world</title>
	<link type="text/rcss" href="rml.rcss"/>
	<link type="text/rcss" href="project_c_gameplay_ui.rcss"/>
</head>
<body>
	<div class="test_container" data-model="test">
		<p>{{character_health}}</p>
		<p>{{enemy_health}}</p>
	</div>
	
	<div data-for="item : items_on_ground">
		<h1>{{item.name}}</h1>
		<p>Item {{it_index + 1}} of {{ item.size }}.</p>
	</div>
	
	<div class="item_on_ground" 
		data-model="DMitemname" data-if="show_item == true"
		data-event-click="equip";
		data-style-left="item_pos_x" data-style-bottom="item_pos_y">
			<p>{{item_name}}</p>
	</div>
</body>
</rml>