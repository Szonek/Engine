body {
	font-family: Tahoma;
	font-size: 18px;

    height: 100%;
    width: 100%;
	text-align: center;
}

div.test_container 
{
	position: absolute;
	width: 10%;
	left: 90%;
	top: 0%;
	background-color: yellow;
	color: black;
	text-align: center;
}
	
div.item_on_ground 
{  
	position: absolute;
	text-align: center;
	padding: 0px 10px 2px 10px;

	opacity: 0.6;	
	font-effect: outline(2px black);
	background-color: #33290c;
	color: white;	
}

div.item_on_ground:hover
{
	 border: 2px #ffffff;
	 margin: -2px;
}

div.healthbar
{
	position: absolute;
	background-color: #33ff57;
	
	
	width: 10%;
	height: 1%;
	background-color: #00FF00;
}