body {
	font-family: Tahoma;
	font-size: 18px;
	
    height: 100%;
    width: 100%;
	text-align: center;
}

div.container 
{
	position: absolute;
	width: 10%;
	left: 90%;
	background-color: yellow;
	color: black;
	text-align: center;
}
	
div.container2 
{  
	position: absolute;
	text-align: center;
	padding: 0px 10px 0px 10px;
	
	opacity: 0.6;	
	font-effect: outline(2px black);
	background-color: #33290c;
	color: white;	
}