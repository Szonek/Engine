body {
	font-family: Tahoma;
	font-size: 18px;

    height: 100%;
    width: 100%;
	text-align: center;
}
	
.item_on_ground 
{  
	position: absolute;
	text-align: center;
	padding: 0px 10px 2px 10px;

	opacity: 0.6;	
	font-effect: outline(2px black);
	background-color: #33290c;
	color: white;	
}

.item_on_ground:hover
{
	 border: 2px #ffffff;
	 margin: -2px;
}

.healthbar
{
	position: absolute;
	width: 10%;
	height: 1%;
	
	border: 1px rgb(50%, 50%, 50%);
	background-color: #a18c8a;
}

.healthbar fill
{
	background-color: #00FF00;
}