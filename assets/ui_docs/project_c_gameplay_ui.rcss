body {
	font-family: Tahoma;
	font-size: 18px;
	
    height: 100%;
    width: 100%;
	text-align: center;
}

div.container 
{
	position: absolute;
	width: 10%;
	left: 90%;
	background-color: yellow;
	color: black;
	text-align: center;
}
	
@keyframes animate-filter 
{
    from { filter: drop-shadow(#f00) opacity(1.0) sepia(1.0); }
    to   { filter: drop-shadow(#000 30px 20px 5px) opacity(0.2) sepia(0.2); }
}
	
div.container2 
{  
	position: absolute;
	text-align: center;
	padding: 0px 10px 0px 10px;
	
	animation: animate-filter 1.5s cubic-in-out infinite alternate;
	
	font-effect: outline(2px black);
	background-color: #33290c;
	color: white;	
}