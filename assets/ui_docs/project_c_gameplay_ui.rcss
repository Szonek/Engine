body {
	font-family: Tahoma;
	font-size: 18px;

    height: 100%;
    width: 100%;
	text-align: center;
}
	
.item_on_ground 
{  
	position: absolute;
	text-align: center;
	padding: 0px 10px 2px 10px;

	opacity: 0.6;	
	font-effect: outline(2px black);
	background-color: #33290c;
	color: white;	
}

.item_on_ground:hover
{
	 border: 2px #ffffff;
	 margin: -2px;
}

.healthbar
{
	position: absolute;
	width: 10%;
	height: 1%;
	
	border: 1px rgb(50%, 50%, 50%);
	background-color: #a18c8a;
}

.healthbar fill
{
	background-color: #00FF00;
}

.player_hud
{
	position: absolute;
	left: 2%;
	top: 2%;
	width: 22%;
	text-align: left;
	padding: 8px;
	background-color: #1c1c1c;
	color: white;
}

.player_healthbar
{
	width: 100%;
	height: 18px;
	border: 1px rgb(50%, 50%, 50%);
	background-color: #5b2929;
}

.player_healthbar fill
{
	background-color: #d33b35;
}

.controls
{
	font-size: 14px;
	margin-top: 4px;
}

.encounter_status
{
	position: absolute;
	left: 50%;
	top: 5%;
	width: 50%;
	margin-left: -25%;
	padding: 8px;
	background-color: #1c1c1c;
	color: white;
	font-size: 22px;
}